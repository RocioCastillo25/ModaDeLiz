# Copiar a .env (cp .env.example .env). NUNCA subir .env al repositorio.
# Todos los valores tienen un default en docker-compose.yml; solo cambia lo necesario.

POSTGRES_USER=checklizz
POSTGRES_PASSWORD=checklizz_dev
POSTGRES_DB=checklizz

# --- Puertos de la PC (lado izquierdo del mapeo) ---
# Si Docker dice "port is already allocated" o "address already in use", otro programa
# (por ejemplo un PostgreSQL instalado en Windows) ya usa ese puerto. Cambia solo el de la PC:
#   POSTGRES_PORT=5433
#   KEYCLOAK_PORT=8180
# Dentro de Docker nada cambia. Las URLs de Keycloak para la app y la web usan KEYCLOAK_PORT.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
API_PORT=3000

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- pgAdmin (opcional: docker compose --profile tools up -d) ---
# El correo debe tener un dominio "normal": pgAdmin rechaza terminaciones como .local
PGADMIN_EMAIL=admin@checklizz.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Emisores de token aceptados por la API (separados por coma) ---
# Si lo dejas comentado, el compose usa localhost y 10.0.2.2 (emulador Android) con KEYCLOAK_PORT.
# Telefono fisico: agrega la IP de tu PC (ipconfig en Windows) y el MISMO puerto de Keycloak.
# Si lo descomentas, escribe aqui TODOS los emisores, porque reemplaza al valor por defecto.
# ALLOWED_ISSUERS=http://localhost:8080/realms/checklizz,http://10.0.2.2:8080/realms/checklizz,http://192.168.1.50:8080/realms/checklizz
