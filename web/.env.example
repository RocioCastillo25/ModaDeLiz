# Copiar a .env (cp .env.example .env). NUNCA subir .env al repositorio.

# true = datos simulados, sin Docker ni Keycloak (útil para demos y para avanzar sin la API)
VITE_USE_MOCK=true

# Solo se usan cuando VITE_USE_MOCK=false
VITE_API_URL=http://localhost:3000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=checklizz
VITE_KEYCLOAK_CLIENT_ID=checklizz-app
